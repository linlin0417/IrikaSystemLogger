## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# MonoAutoInstrukt IDE
*.monoauto

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
Generated\ Files/
GeneratedFiles/
[Oo]utput/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/

# Visual Studio IDE temp files
*.aps
*.ncb
*.opendb
*.sdf
*.v12.suo
*.v11.suo

# C++ build results
*.exe
*.dll
*.lib
*.ilk
*.exp
*.map
*.pdb
*.iobj
*.ipdb
*.appx
*.appxbundle
*.msix
*.msixbundle
*.cer
*.pfx

# Directory build results
packages/
*.nupkg

# Temporary files
*.tmp
*.log
*.tlog
*.lastbuildstate
